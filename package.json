    "test:backup-format": "tsx tools/gate6/backup-format.test.ts",
    "test:data-backend": "tsx src/lib/data-backend.test.ts",
    "test:verify-backup": "tsx tools/gate6/verify-backup.ts --selftest",
    "test:production-audit": "tsx tools/gate6/production-audit.ts --selftest",
    "ops:verify-backup": "tsx tools/gate6/verify-backup.ts",
    "ops:backup": "tsx tools/gate6/backup-restore.ts --backup-only",

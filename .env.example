# Local development keeps the existing JSON data by default.
DATA_BACKEND=file

# Vercel Preview and Production must use Supabase.
# REQUIRE_PRODUCTION_SECRETS=1
# DATA_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxx
# APP_ORIGIN=https://your-domain.example
# AUTH_SECRET=replace-with-a-long-random-value
# ADMIN_PASSWORD=replace-with-a-strong-password
# RATE_LIMIT_SECRET=replace-with-another-long-random-value

# 裁判报分功能开关（ADR 决策 10）——托管环境必须显式 =1 才开放裁判写操作。
# 本地隔离环境默认开启，=0 可关闭以验证「关闭时现有平台不受影响」。
# REFEREE_REPORTING_ENABLED=1
